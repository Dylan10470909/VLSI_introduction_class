module AU(inA,inB,out1,out2,out3);
input 	 	[3:0]	inA,inB,inC,inD;
input 	 	[2:0]   select;
output	 	reg[3:0] out;

always@(select)begin
         if(select= 2'b00) out=inA;
          else if(select= 2'b01) out=inB;
           else if(select= 2'b10) out=inC;  
            else if(select= 2'b11) out=inD; 

endmodule
