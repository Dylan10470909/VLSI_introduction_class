module Case(inA,inB,out1,out2,out3);
input 	 	[3:0]	inA,inB,inC,inD;
input 	 	[2:0]   select;
output	    reg[3:0] out;

always@(select)begin
         out=(select== 2'b00) ?inA:
             (select== 2'b01) ?inB:
             (select== 2'b10) ?inC:  
             (select== 2'b11) ?inD:
                              1'bx; 
end
endmodule
